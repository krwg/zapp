{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window permissions for zapp",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "allow-get-snapshot",
    "allow-get-diagnostics",
    "allow-get-updates",
    "allow-set-engine-running",
    "allow-set-active-profile",
    "allow-start-diagnostics",
    "allow-cancel-diagnostics",
    "allow-select-diagnostic-strategy",
    "allow-check-service",
    "allow-check-all-services",
    "allow-check-updates",
    "allow-update-channel",
    "allow-update-settings",
    "allow-set-theme",
    "allow-run-preflight",
    "allow-reset-engine",
    "allow-open-external-url",
    "allow-get-recent-errors",
    "allow-get-bug-report-bundle",
    "allow-import-engine-pack",
    "allow-apply-working-mode",
    "allow-resolve-conflicts",
    "allow-get-conflicts",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "updater:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize"
  ]
}
