{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "zapp",
  "version": "0.2.7",
  "identifier": "app.zapp.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "zapp",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://ipc.localhost; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "krwg",
    "copyright": "Copyright © 2026 krwg",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "shortDescription": "Convenient zapret management",
    "longDescription": "zapp brings zapret tools into one soft-minimal desktop client: DPI bypass control, smart mode checks, sites, and independent updates for App, Engine, and Strategies.",
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": true,
        "startMenuFolder": "zapp",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "installerHooks": "windows/hooks.nsi"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhEQ0MyRDhBRkEyMzMzN0EKUldSNk15UDZpaTNNamJnNGIvci9GR21GWmZtVmxCcXJKRnZSdGlCRkpPNlcrbnNvbzQ5eUNOT1YK",
      "endpoints": [
        "https://github.com/krwg/zapp/releases/latest/download/latest.json"
      ]
    }
  }
}
